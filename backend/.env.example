# ============================================================
# CONFIGURACIÓN DE APLICACIÓN
# Copiar este archivo a .env y ajustar los valores.
# Para una nueva app, solo cambiar MODULE_CODE y las credenciales de BD.
# ============================================================

# ── Módulo SSO ───────────────────────────────────────────────
# Código del módulo en T_ADMI_MODULO de la BD centralizada de APEX.
# Define qué páginas y permisos se cargan para esta aplicación.
MODULE_CODE=MTTO

# ── Modo de conexión ─────────────────────────────────────────
# false = Oracle real | true = SQLite demo local (sin validación SSO)
USE_SQLITE_DEMO=false

# ── Conexión Oracle ──────────────────────────────────────────
DB_USER=DATA
DB_PASSWORD=
DB_HOST=
DB_PORT=1521
DB_SERVICE_NAME=

# ── Validación de sesión APEX ────────────────────────────────
# true  = verifica contra APEX_WORKSPACE_SESSIONS (requiere GRANT)
# false = solo valida que el usuario exista en VT_CORP_USUARIO (dev)
APEX_VALIDATE_SESSION=true
